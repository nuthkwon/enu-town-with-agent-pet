# Top-level variables for compose.yaml (copy to .env next to compose.yaml). Service secrets live in deploy/env/*.env.
# Public HTTPS host. Claude reaches /api/mcp and the OAuth endpoints here, and the connector's URL is fixed to it.
PUBLIC_HOST=den.enu-tech.co.kr
# Email for the Let's Encrypt account (required: certificate expiry notices go here).
ACME_EMAIL=CHANGE_ME@enu-tech.co.kr
# Optional allowlist for machine-to-machine paths (/api/mcp, token): Claude egress is 160.79.104.0/21.
M2M_ALLOWED_CIDRS=0.0.0.0/0 ::/0
