# Local full-stack entry point on http://localhost:8080 (same paths as production).
{
	auto_https off
}

:8080 {
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri query {
					delete _authToken
				}
			}
		}
	}
	@unlogged path /api/v1/pet-channel/poll /api/v1/users/*
	log_skip @unlogged
	route {
		request_body /api/mcp {
			max_size 64KB
		}
		request_body /api/v1/pet-channel/* {
			max_size 16KB
		}
		handle_path /colyseus/* {
			reverse_proxy {$REALTIME_UPSTREAM:realtime:2567}
		}
		reverse_proxy {$WEB_UPSTREAM:web:3000}
	}
}
