# ENU Den edge (production). Automatic HTTPS for {$PUBLIC_HOST}.
{
	email {$ACME_EMAIL}
}

{$PUBLIC_HOST} {
	encode zstd gzip

	log {
		output stdout
		format filter {
			wrap json
			fields {
				# Colyseus puts the realtime ticket in the WebSocket URL; never log it.
				request>uri query {
					delete _authToken
				}
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}

	# Not logged per request: the pet channel (polls every 25 s per paired machine, replies), my pet rooms and
	# the channel status the messenger re-reads every 30 s, and colleagues' pages and reads. A line per request
	# would be a presence and conversation history per address (ADR 0004, ADR 0006, messenger-spec §9).
	@unlogged path /api/v1/pet-channel/* /api/v1/me/pet-channel/* /api/v1/me/pets/* /api/v1/users/* /people/*
	log_skip @unlogged

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}

	# `route` keeps the order exactly as written.
	route {
		# Optional allow-list for machine-to-machine endpoints (Claude egress 160.79.104.0/21 + office/VPN).
		# Default allows everyone; set M2M_ALLOWED_CIDRS once the pilot confirmed where Claude calls come from.
		@m2m_denied {
			path /api/mcp /api/mcp/* /api/auth/oauth2/token /api/auth/oauth2/register /.well-known/oauth-protected-resource* /.well-known/oauth-authorization-server*
			not remote_ip {$M2M_ALLOWED_CIDRS:0.0.0.0/0 ::/0}
		}
		respond @m2m_denied 403

		request_body /api/mcp {
			max_size 64KB
		}
		request_body /api/v1/pet-channel/* {
			max_size 16KB
		}

		# Colyseus only serves at the root, so strip the prefix (matchmake + WebSocket).
		handle_path /colyseus/* {
			reverse_proxy realtime:2567
		}

		reverse_proxy web:3000
	}
}
