{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/fx-after-edit.mjs\"",
            "timeout": 180,
            "statusMessage": "den-fx: rendering and checking the edited effect or sound"
          }
        ]
      }
    ]
  }
}
