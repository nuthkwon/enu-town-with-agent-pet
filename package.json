{
  "name": "enu-den",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=!@enu/e2e",
    "test:int": "turbo run test:int --concurrency=1",
    "test:e2e": "pnpm --filter @enu/e2e test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:policy": "bash scripts/verify-policy.sh",
    "db:generate": "pnpm --filter @enu/db generate",
    "db:migrate": "pnpm --filter @enu/db migrate",
    "seed:seats": "pnpm --filter @enu/db seed:seats",
    "seed:dev": "pnpm --filter @enu/db seed:dev",
    "sprites:build": "pnpm --filter @enu/sprites build && pnpm --filter @enu/fx bake",
    "map:gen": "pnpm --filter @enu/map gen",
    "map:check": "pnpm --filter @enu/map check",
    "fx": "pnpm --filter @enu/fx fx",
    "fx:list": "pnpm --filter @enu/fx fx list",
    "fx:library": "pnpm --filter @enu/fx fx library",
    "fx:new": "pnpm --filter @enu/fx fx new",
    "fx:render": "pnpm --filter @enu/fx fx render",
    "fx:check": "pnpm --filter @enu/fx fx check",
    "sfx": "pnpm --filter @enu/sfx sfx",
    "sfx:list": "pnpm --filter @enu/sfx sfx list",
    "sfx:render": "pnpm --filter @enu/sfx sfx render",
    "sfx:check": "pnpm --filter @enu/sfx sfx check"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
